// Reglas de seguridad de Firestore para Nuevas Miradas (convocatoria LAFITA).
// Se pegan en Firebase: Firestore Database → Rules → Publish.
//
// - El público solo puede CREAR inscripciones (no puede leer ni cambiar nada),
//   hasta la fecha de cierre y con todos los datos obligatorios bien.
// - El comité (con login) puede verlo todo, cambiar el estado, escribir notas y borrar.
//
// Cada año: cambia la fecha de cierre (abajo) y "edicion".
// Si cambias campos en campos.js, cambia también las listas de esta función.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esEquipo() { return request.auth != null; }

    // Texto con largo entre min y max
    function txt(d, k, min, max) { return d[k] is string && d[k].size() >= min && d[k].size() <= max; }
    // Número entero entre min y max (o null si es opcional)
    function num(d, k, min, max) { return d[k] is int && d[k] >= min && d[k] <= max; }
    function numOpt(d, k, min, max) { return d[k] == null || num(d, k, min, max); }
    // Opción de una lista ('' si es opcional)
    function opc(d, k, lista) { return d[k] in lista; }

    function valida(d) {
      return d.keys().hasOnly([
          'titulo', 'tituloEn', 'anio', 'duracion', 'tipo', 'paises', 'idiomas', 'subtitulos',
          'sinopsisCorta', 'sinopsis', 'relacionLatam', 'estreno', 'festivales', 'formato',
          'dirNombre', 'dirPronombres', 'dirNacimiento', 'dirEmail', 'dirTelefono', 'dirNacionalidad',
          'dirOrigen', 'dirCiudad', 'dirDesde', 'dirObra', 'dirEscuela', 'dirBio', 'dirFilmografia', 'dirWeb',
          'productora', 'contNombre', 'contRol', 'contEmail',
          'screener', 'screenerPass', 'trailer', 'stills', 'presskit',
          'asistencia', 'comoSupiste', 'comentarios', 'chkDerechos', 'chkBases', 'chkPrivacidad',
          'categoria', 'codigo', 'edicion', 'estado', 'idioma', 'creadoEn'])
        && d.keys().hasAll([
          'titulo', 'anio', 'duracion', 'tipo', 'paises', 'idiomas', 'subtitulos',
          'sinopsisCorta', 'sinopsis', 'relacionLatam', 'estreno', 'formato',
          'dirNombre', 'dirEmail', 'dirNacionalidad', 'dirCiudad', 'dirDesde', 'dirObra', 'dirBio',
          'screener', 'asistencia', 'chkDerechos', 'chkBases', 'chkPrivacidad',
          'categoria', 'codigo', 'edicion', 'estado', 'idioma', 'creadoEn'])

        // 01 La película
        && txt(d, 'titulo', 1, 200) && txt(d, 'tituloEn', 0, 200)
        && num(d, 'anio', 2026, 2027) && num(d, 'duracion', 1, 600)
        && opc(d, 'tipo', ['ficcion', 'documental', 'animacion', 'experimental', 'hibrido'])
        && txt(d, 'paises', 1, 200) && txt(d, 'idiomas', 1, 200)
        && d.subtitulos is list && d.subtitulos.size() >= 1 && d.subtitulos.size() <= 5
        && d.subtitulos.toSet().difference(['de', 'en', 'es', 'otros', 'no'].toSet()).size() == 0
        && txt(d, 'sinopsisCorta', 20, 300) && txt(d, 'sinopsis', 100, 1500) && txt(d, 'relacionLatam', 20, 800)
        && opc(d, 'estreno', ['mundial', 'internacional', 'alemania', 'muenchen', 'ya'])
        && txt(d, 'festivales', 0, 1000)
        && opc(d, 'formato', ['dcp', 'prores', 'h264', 'otro'])

        // 02 Dirección
        && txt(d, 'dirNombre', 2, 200) && txt(d, 'dirPronombres', 0, 60)
        && numOpt(d, 'dirNacimiento', 1940, 2013)
        && txt(d, 'dirEmail', 5, 160) && d.dirEmail.matches('.+@.+[.].+')
        && txt(d, 'dirTelefono', 0, 40) && txt(d, 'dirNacionalidad', 1, 120)
        && txt(d, 'dirOrigen', 0, 200) && txt(d, 'dirCiudad', 1, 120)
        && num(d, 'dirDesde', 1950, 2027)
        && opc(d, 'dirObra', ['corto', 'debut', 'segunda', 'mas'])
        && txt(d, 'dirEscuela', 0, 200) && txt(d, 'dirBio', 50, 800)
        && txt(d, 'dirFilmografia', 0, 1500) && txt(d, 'dirWeb', 0, 300)

        // 03 Producción y contacto
        && txt(d, 'productora', 0, 200) && txt(d, 'contNombre', 0, 200)
        && txt(d, 'contRol', 0, 100) && txt(d, 'contEmail', 0, 160)

        // 04 Material
        && txt(d, 'screener', 10, 500) && d.screener.matches('https?://.+')
        && txt(d, 'screenerPass', 0, 100) && txt(d, 'trailer', 0, 500)
        && txt(d, 'stills', 0, 500) && txt(d, 'presskit', 0, 500)

        // 05 Para terminar
        && opc(d, 'asistencia', ['si', 'quizas', 'no'])
        && txt(d, 'comoSupiste', 0, 200) && txt(d, 'comentarios', 0, 1000)
        && d.chkDerechos == true && d.chkBases == true && d.chkPrivacidad == true

        // Datos que pone la web
        && opc(d, 'categoria', ['corto', 'medio', 'largo'])
        && d.codigo is string && d.codigo.matches('NM[0-9]{2}-[A-Z0-9]{5}')
        && d.edicion == 2027
        && d.estado == 'nueva'
        && opc(d, 'idioma', ['de', 'es', 'en', 'pt'])
        && d.creadoEn == request.time;
    }

    match /envios/{id} {
      // Inscribir (público): hasta el 30.06.2027 a las 23:59 de Múnich (= 21:59 UTC)
      allow create: if request.time < timestamp.date(2027, 6, 30) + duration.value(22, 'h')
        && valida(request.resource.data);

      // Ver, cambiar estado / notas y borrar: solo el comité
      allow read, update, delete: if esEquipo();
    }
  }
}
